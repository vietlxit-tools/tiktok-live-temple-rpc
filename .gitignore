# ============================================================================
# .gitignore: Chùa Linh Ứng Online — TikTok Live RPC
# Bỏ qua dependencies, runtime caches, models nặng, audio lớn và file rác.
# ============================================================================

# 1. Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Python Environments, Bytecode & Testing
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# 3. Large Machine Learning Models & Heavy Media (lưu trữ cục bộ, không commit Git)
models/
*.onnx
*.data
*.bin
*.pt
*.pth
*.safetensors
public/assets/*.mp3
*.mp3
*.m4a
*.wav
*.ogg
*.flac
*.aac

# 4. Runtime Caches, Model Download Cache & Logs
data/tts-cache/
data/.hf_cache/
*.log
logs/
*.lock
!package-lock.json
!bun.lock

# 5. Environment Variables & Secrets
.env
.env*.local
.env.production
.env.development
*.env
!.env.example

# 6. Operating System & IDE Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# 7. AI Agent, MCP & Analysis Cache
.gemini/
.playwright-mcp/
scratch/
graphify-out/

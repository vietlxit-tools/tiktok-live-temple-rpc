# 1. Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Python Environments, Bytecode & Testing
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# 3. Runtime Caches, Model Download Cache & Logs
data/tts-cache/
data/.hf_cache/
models/**/.cache/
*.log
logs/
*.lock
!package-lock.json

# 4. Environment Variables & Secrets
.env
.env*.local
.env.production
.env.development
*.env
!.env.example

# 5. Operating System & IDE Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# 6. AI Agent, MCP & Analysis Cache
.gemini/
.playwright-mcp/
scratch/
graphify-out/
